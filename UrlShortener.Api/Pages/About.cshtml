@page
@model UrlShortener.Api.Pages.AboutModel
@{
    ViewData["Title"] = "Про алгоритм";
}

<div style="max-width: 800px; margin: 40px auto; font-family: sans-serif;">
    <h1>Як працює наш URL Shortener</h1>
    
    @if (Model.IsSuccess)
    {
        <div style="background: #d4edda; color: #155724; padding: 10px; border-radius: 5px; margin-bottom: 20px;">
            Дані успішно оновлено!
        </div>
    }

    @if (Model.IsAdmin)
    {
        <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #ddd;">
            <p><strong>Режим редагування (Тільки для Адміністратора)</strong></p>
            <form method="post">
                <textarea asp-for="Content" rows="6" style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #ccc;"></textarea>
                <br /><br />
                <button type="submit" style="background: #007bff; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer;">
                    Зберегти зміни
                </button>
            </form>
        </div>
    }
    else
    {
        <div style="font-size: 1.1em; line-height: 1.6; padding: 20px 0;">
            @Html.Raw(Model.Content.Replace("\n", "<br/>"))
        </div>
    }

    <p style="color: #666; font-size: 0.9em; margin-top: 20px;">
        <em>Останнє оновлення зробив: @Model.LastUpdatedBy</em>
    </p>
</div>